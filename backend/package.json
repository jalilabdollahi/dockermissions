{
  "name": "dockermissions-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "catalog": "node ../scripts/build-catalog.mjs",
    "test:missions": "tsx src/tools/testMissions.ts",
    "postinstall": "node -e \"const fs=require('fs'),p=require('path');for(const d of ['darwin-arm64','darwin-x64']){const f=p.join('node_modules','node-pty','prebuilds',d,'spawn-helper');if(fs.existsSync(f))fs.chmodSync(f,0o755)}\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "node-pty": "^1.1.0",
    "uuid": "^11.0.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
